{
  "expo": {
    "name": "Jumpstart",
    "slug": "remote-wol",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "remotewol-upsnap",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/remotewol-ios.icon",
      "bundleIdentifier": "com.abunchofknowitalls.remotewol-upsnap",
      "appleTeamId": "8S7C654DQ4",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.abunchofknowitalls.remotewol-upsnap"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "./plugins/withWakeControl.js",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.abunchofknowitalls.remotewol-upsnap.widget",
          "groupIdentifier": "group.abunchofknowitalls.remotewol-upsnap",
          "widgets": [
            {
              "name": "DeviceControl",
              "displayName": "Device Control",
              "description": "Control your devices with wake, sleep, restart, and shutdown actions.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "initialLayout": "./src/widgets/DeviceControl.tsx",
                "configuration": {
                  "title": "Device Control",
                  "description": "Select a device to control from your home screen.",
                  "parameters": {
                    "device": {
                      "title": "Device",
                      "type": "enum",
                      "default": "none",
                      "dynamic": true,
                      "values": [
                        {
                          "name": "Select a Device",
                          "value": "none"
                        }
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-app-intents"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "app-intents"
        ]
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2c99399-8470-4a78-9253-492056fc1c35"
      }
    }
  }
}
